<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- Log directory -->
    <property name="LOG_DIR" value="logs"/>

    <!-- Main log file -->
    <property name="LOG_FILE" value="${LOG_DIR}/employee-management.log"/>

    <!-- Log format -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [requestId=%X{requestId}] [user=%X{username}] [%thread] %logger{36} - %msg%n"/>

    <!-- ========================= -->
    <!-- Console Appender -->
    <!-- ========================= -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ========================= -->
    <!-- File Appender -->
    <!-- ========================= -->

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_FILE}</file>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>


        <!-- ========================= -->
        <!-- Rolling Policy -->
        <!-- ========================= -->

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- Archived logs -->
            <fileNamePattern>
                ${LOG_DIR}/archive/employee-management.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <!-- Maximum size of one log file -->
            <maxFileSize>10MB</maxFileSize>

            <!-- Keep logs for 30 days -->
            <maxHistory>30</maxHistory>

            <!-- Maximum total size of archived logs -->
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>

    <!-- Application logging -->
    <logger name="Naresh.employee_management" level="INFO"/>

    <!-- Spring Framework -->
    <logger name="org.springframework" level="INFO"/>

    <!-- Spring Security -->
    <logger name="org.springframework.security" level="INFO"/>

    <!-- Hibernate -->
    <logger name="org.hibernate" level="WARN"/>

    <!-- Hibernate SQL -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <!-- Disable SQL bind parameter logging -->
    <logger name="org.hibernate.orm.jdbc.bind" level="OFF"/>


    <!-- ========================= -->
    <!-- Root Logger -->
    <!-- ========================= -->

    <root level="INFO">

        <appender-ref ref="CONSOLE"/>

        <appender-ref ref="FILE"/>

    </root>

</configuration>